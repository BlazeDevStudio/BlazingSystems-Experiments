#!/bin/sh
# BLAZE_R281_RENTAL_HUB operator endpoint v0.1.3-preview.1
set -u
umask 077
BASE="${BLAZE_RENTAL_BASE:-/etc/blazepwifi-rental}"
STATE="$BASE/state"; DEVICES="$STATE/devices.tsv"; ENROLL="$STATE/enroll.tsv"; POLICY="$STATE/policy.tsv"; EVENTS="$STATE/events.tsv"; TOKEN_FILE="$BASE/admin.token"
mkdir -p "$STATE" 2>/dev/null || true
for f in "$DEVICES" "$ENROLL" "$POLICY" "$EVENTS"; do [ -f "$f" ] || : > "$f"; chmod 600 "$f" 2>/dev/null || true; done
json_escape(){ printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\r//g; s/\n/\\n/g'; }
json(){ printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nX-Frame-Options: DENY\r\n\r\n%s\n' "$1"; }
fail(){ json "{\"ok\":false,\"error\":\"$(json_escape "$1")\"}"; exit 0; }
now(){ date +%s; }
randhex(){
  n="${1:-12}"
  case "$n" in ''|*[!0-9]*) return 1;; esac
  [ "$n" -ge 1 ] && [ "$n" -le 32 ] || return 1
  rstatus=0; hstatus=0; ostatus=0; hlen=0; olen=0
  x="$(openssl rand -hex "$n" 2>/dev/null)" || rstatus=$?
  rlen="${#x}"
  case "$x" in *[!0-9a-f]*) x='';; esac
  if [ "${#x}" -ne $((n*2)) ]; then
    x="$(hexdump -n "$n" -e '1/1 "%02x"' /dev/urandom 2>/dev/null)" || hstatus=$?
  fi
  hlen="${#x}"
  case "$x" in *[!0-9a-f]*) x='';; esac
  if [ "${#x}" -ne $((n*2)) ]; then
    raw="$(od -An -N "$n" -tx1 /dev/urandom 2>/dev/null)" || ostatus=$?
    x="$(printf '%s' "$raw" | tr -d ' \n')"
    olen="${#x}"
  fi
  case "$x" in *[!0-9a-f]* ) x='';; esac
  [ "${#x}" -eq $((n*2)) ] || {
    printf 'rental entropy incomplete: requested=%s openssl_status=%s openssl_hex=%s hexdump_status=%s hexdump_hex=%s od_status=%s od_hex=%s\n' "$n" "$rstatus" "$rlen" "$hstatus" "$hlen" "$ostatus" "$olen" >&2
    return 1
  }
  printf '%s' "$x"
}
url_decode(){ printf '%s' "$1" | awk 'function hx(c,p){c=toupper(c);p=index("0123456789ABCDEF",c);return p?p-1:-1}{s=$0;out="";for(i=1;i<=length(s);i++){c=substr(s,i,1);if(c=="%"&&i+2<=length(s)){a=hx(substr(s,i+1,1));b=hx(substr(s,i+2,1));if(a>=0&&b>=0){out=out sprintf("%c",a*16+b);i+=2;continue}}if(c=="+")c=" ";out=out c}printf "%s",out}'; }
BODY=""; [ "${REQUEST_METHOD:-GET}" = POST ] && IFS= read -r BODY || true
param(){ k="$1"; data="${QUERY_STRING:-}"; [ "${REQUEST_METHOD:-GET}" = POST ] && data="$BODY"; raw="$(printf '%s' "$data" | tr '&' '\n' | awk -F= -v k="$k" '$1==k {sub(/^[^=]*=/,"");print;exit}')"; url_decode "$raw"; }
atomic_replace(){ src="$1" dst="$2"; chmod 600 "$src" 2>/dev/null || return 1; sync 2>/dev/null || return 1; mv "$src" "$dst" || return 1; sync 2>/dev/null || return 1; }
lock(){ mkdir "$STATE/.lock" 2>/dev/null; }
unlock(){ rmdir "$STATE/.lock" 2>/dev/null || true; }
with_lock(){ i=0; while ! lock; do i=$((i+1)); [ "$i" -lt 30 ] || return 1; sleep 1; done; return 0; }
check_auth(){
  [ -s "$TOKEN_FILE" ] || fail "admin token missing"
  expected="$(cat "$TOKEN_FILE")"; got="${HTTP_X_BLAZE_RENTAL_ADMIN:-$(param admin_token)}"
  [ -n "$got" ] && [ "$got" = "$expected" ] || fail "unauthorized"
}
device_line(){ awk -F '\t' -v d="$1" '$1==d {print;exit}' "$DEVICES"; }
valid_lease(){
  case "$1" in 0) return 0;; [1-9]*) ;; *) return 1;; esac
  case "$1" in *[!0-9]*) return 1;; esac
  [ "${#1}" -le 10 ] && [ "$1" -le 2147483647 ] 2>/dev/null
}
write_device(){ did="$1" secret="$2" lease="$3" label="$4" last="$5"; suffix="$(randhex 3)" || return 1; tmp="$STATE/.devices.$$.$suffix"; awk -F '\t' -v d="$did" '$1!=d {print}' "$DEVICES" > "$tmp" || return 1; clean="$(printf '%s' "$label" | tr '\t\r\n' '   ' | cut -c1-80)"; printf '%s\t%s\t%s\t%s\t%s\n' "$did" "$secret" "$lease" "$clean" "$last" >> "$tmp" || return 1; atomic_replace "$tmp" "$DEVICES"; }
remove_device(){ did="$1"; for spec in "$DEVICES:1" "$POLICY:1"; do f="${spec%%:*}"; suffix="$(randhex 3)" || return 1; tmp="$STATE/.rm.$$.$suffix"; awk -F '\t' -v d="$did" '$1!=d {print}' "$f" > "$tmp" || return 1; atomic_replace "$tmp" "$f" || return 1; done; }
log(){ printf '%s\t%s\t%s\t%s\n' "$(now)" "$1" "$2" "${REMOTE_ADDR:-local}" >> "$EVENTS"; chmod 600 "$EVENTS"; }

[ "${REQUEST_METHOD:-GET}" = POST ] || fail "POST required"
check_auth
action="$(param action)"; ts="$(now)"
case "$action" in
  health)
    json "{\"ok\":true,\"mode\":\"manual-rental-test\",\"server_time\":$ts,\"board\":\"R281\",\"version\":\"0.1.3-preview.1\"}"
    ;;
  list)
    first=1; out='['
    while IFS="$(printf '\t')" read -r did secret lease label last; do
      [ -n "$did" ] || continue
      valid_lease "$lease" || fail "corrupt lease state"
      remaining=0; [ "${lease:-0}" -gt "$ts" ] 2>/dev/null && remaining=$((lease-ts))
      seen="$last"
      if [ -f "$STATE/seen-$did" ] && [ ! -L "$STATE/seen-$did" ]; then
        seen="$(cat "$STATE/seen-$did" 2>/dev/null)" || seen="$last"
      fi
      case "$seen" in ''|*[!0-9]*) seen=0;; esac
      [ "${#seen}" -le 10 ] || seen=0
      [ "$first" = 1 ] || out="$out,"; first=0
      out="$out{\"device_id\":\"$did\",\"label\":\"$(json_escape "$label")\",\"lease_until\":${lease:-0},\"remaining\":$remaining,\"last_seen\":$seen}"
    done < "$DEVICES"
    out="$out]"; json "{\"ok\":true,\"devices\":$out,\"server_time\":$ts}"
    ;;
  enroll_create)
    label="$(param label)"; ttl="$(param ttl)"; [ -n "$label" ] || label="Rental phone"
    printf '%s' "$label" | grep -q '[[:cntrl:]]' && fail "invalid label"
    case "$ttl" in ''|*[!0-9]*) ttl=900;; esac; [ "$ttl" -ge 60 ] && [ "$ttl" -le 3600 ] || ttl=900
    eid="$(randhex 6)" || fail "secure randomness unavailable"
    secret="$(randhex 18)" || fail "secure randomness unavailable"
    exp=$((ts+ttl)); clean="$(printf '%s' "$label" | tr '\t\r\n' '   ' | cut -c1-80)"
    printf '%s\t%s\t%s\t%s\n' "$eid" "$secret" "$exp" "$clean" >> "$ENROLL"; chmod 600 "$ENROLL"; sync 2>/dev/null || true
    log enrollment_created "$eid"
    json "{\"ok\":true,\"token\":\"$eid.$secret\",\"expires\":$exp}"
    ;;
  add_time|set_time|expire|rename|revoke)
    did="$(param device_id)"; printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || fail "invalid device id"
    with_lock || fail "server busy"
    line="$(device_line "$did")"; [ -n "$line" ] || { unlock; fail "unknown device"; }
    secret="$(printf '%s' "$line" | cut -f2)"; lease="$(printf '%s' "$line" | cut -f3)"; label="$(printf '%s' "$line" | cut -f4)"; last="$(printf '%s' "$line" | cut -f5)"
    valid_lease "$lease" || { unlock; fail "corrupt lease state"; }
    case "$action" in
      add_time)
        sec="$(param seconds)"; case "$sec" in ''|*[!0-9-]*) unlock; fail "invalid seconds";; esac
        [ "$sec" -ge -604800 ] 2>/dev/null && [ "$sec" -le 2592000 ] 2>/dev/null || { unlock; fail "seconds out of range"; }
        base="$lease"; [ "$base" -ge "$ts" ] 2>/dev/null || base="$ts"; new=$((base+sec)); [ "$new" -ge "$ts" ] 2>/dev/null || new="$ts"
        write_device "$did" "$secret" "$new" "$label" "$last" || { unlock; fail "storage outcome uncertain; inspect lease before retry"; }; unlock; log time_added "$did:$sec"; json "{\"ok\":true,\"lease_until\":$new,\"remaining\":$((new-ts))}"
        ;;
      set_time)
        sec="$(param seconds)"; case "$sec" in ''|*[!0-9]*) unlock; fail "invalid seconds";; esac
        [ "$sec" -ge 0 ] 2>/dev/null && [ "$sec" -le 2592000 ] 2>/dev/null || { unlock; fail "seconds out of range"; }
        new=$((ts+sec)); write_device "$did" "$secret" "$new" "$label" "$last" || { unlock; fail "storage outcome uncertain; inspect lease before retry"; }; unlock; log time_set "$did:$sec"; json "{\"ok\":true,\"lease_until\":$new,\"remaining\":$sec}"
        ;;
      expire)
        write_device "$did" "$secret" "$ts" "$label" "$last" || { unlock; fail "storage outcome uncertain; inspect lease before retry"; }; unlock; log expired "$did"; json "{\"ok\":true,\"lease_until\":$ts,\"remaining\":0}"
        ;;
      rename)
        nl="$(param label)"; [ -n "$nl" ] || { unlock; fail "label required"; }; printf '%s' "$nl" | grep -q '[[:cntrl:]]' && { unlock; fail "invalid label"; }
        write_device "$did" "$secret" "$lease" "$nl" "$last" || { unlock; fail "storage outcome uncertain; inspect lease before retry"; }; unlock; log renamed "$did"; json "{\"ok\":true}"
        ;;
      revoke)
        remove_device "$did" || { unlock; fail "storage outcome uncertain; inspect lease before retry"; }; unlock; log revoked "$did"; json "{\"ok\":true}"
        ;;
    esac
    ;;
  recent_events)
    lines="$(tail -n 40 "$EVENTS" 2>/dev/null | sed 's/\\/\\\\/g; s/"/\\"/g' | awk -F '\t' 'BEGIN{printf "["}{if(NR>1)printf ",";printf "{\"time\":%s,\"event\":\"%s\",\"detail\":\"%s\",\"source\":\"%s\"}",$1,$2,$3,$4}END{printf "]"}')"
    json "{\"ok\":true,\"events\":$lines}"
    ;;
  *) fail "unknown admin action" ;;
esac
