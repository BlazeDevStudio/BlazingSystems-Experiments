#!/bin/sh
# A modem transaction may queue briefly, but never wait indefinitely for another client.
exec 9>/var/lock/blaze-at.lock
N=0
until /usr/bin/flock -n -x 9;do
 N=$((N+1));[ "$N" -lt 20 ] || { echo 'Modem busy. No command was sent.' >&2;exit 75; }
 sleep 1
done
exec /usr/bin/timeout -k 3 45 /usr/libexec/blaze-gcom.bin "$@"
