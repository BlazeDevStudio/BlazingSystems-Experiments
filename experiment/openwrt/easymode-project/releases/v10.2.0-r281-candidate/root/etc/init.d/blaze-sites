#!/bin/sh /etc/rc.common
START=97
USE_PROCD=1
start_service() {
 if ! jsonfilter -i /etc/blaze/sites.json -e '@.enabled' 2>/dev/null | grep -q '^true$';then
  /usr/libexec/blaze-sites-firewall
  return
 fi
 rm -f /tmp/blaze-sites-status.json
 procd_open_instance
 procd_set_param command /usr/bin/ucode /usr/share/blaze/sites-daemon.uc
 procd_set_param respawn 3600 5 5
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_close_instance
}
service_started() {
 if jsonfilter -i /etc/blaze/sites.json -e '@.enabled' 2>/dev/null | grep -q '^true$';then
  for n in 1 2 3 4 5;do [ -s /tmp/blaze-sites-status.json ] && break;sleep 1;done
  [ -s /tmp/blaze-sites-status.json ] || return 1
 fi
 /usr/libexec/blaze-sites-firewall
}
stop_service() {
 nft delete table inet blaze_sites 2>/dev/null || true
 nft delete table bridge blaze_sites 2>/dev/null || true
 rm -f /tmp/blaze-sites-status.json
}
service_triggers() { procd_add_reload_trigger network wireless firewall; }
reload_service() { stop;start; }
