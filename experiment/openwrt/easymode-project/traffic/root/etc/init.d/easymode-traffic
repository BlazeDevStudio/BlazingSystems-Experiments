#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
 procd_open_instance
 procd_set_param command /usr/libexec/easymode-traffic-worker
 procd_set_param respawn 3600 5 5
 procd_set_param limits core="0" nofile="128"
 procd_set_param term_timeout 10
 procd_close_instance
}
service_triggers() { procd_add_reload_trigger easymode_traffic; }
reload_service() { touch /tmp/easymode-traffic/reconfigure; }
