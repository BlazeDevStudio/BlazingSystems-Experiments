import {readfile,writefile,rename,stat,mkdir,chmod,popen,unlink} from 'fs';
import {cursor} from 'uci';
function readJSON(path,fallback) {try {if((stat(path)?.size || 0)>2097152)return fallback;let r=json(readfile(path));return type(r)=='object'?r:fallback;}catch(e){return fallback;}}
function atomic(path,value) {writefile(path+'.new',sprintf('%J',value));chmod(path+'.new',0600);if(!rename(path+'.new',path))die('Atomic state write failed');}
function settings() {let u=cursor(),s=u.get_all('easymode_traffic','main') || {};return {enabled:s.enabled!='0',domains:s.domains=='1',devices:s.devices=='1',interval:int(s.interval) in [5,15,30,60]?int(s.interval):15,retention:max(1,min(90,int(s.retention || 31))),limit:max(16,min(256,int(s.limit || 64))),edition:s.edition || 'generic',wan:type(s.wan)=='array'?s.wan:[],lan:type(s.lan)=='array'?s.lan:['lan'],cap_gb:max(0,int(s.cap_gb || 0)),warning:max(1,min(100,int(s.warning || 80))),billing_day:max(1,min(28,int(s.billing_day || 1))),checkpoint:1800};}
function command(cmd) {let p=popen(cmd,'r');if(!p)return '';let out=p.read('all');let rc=p.close();return rc==0?out:'';}
function validState(s){return s.schema==1&&type(s.days)=='object'&&type(s.devices)=='object'&&type(s.previous)=='object'&&type(s.wan)=='array';}
function loadState() {for(let path in ['/tmp/easymode-traffic/state.json','/etc/easymode-traffic/history.json','/etc/easymode-traffic/history.backup.json']){let s=readJSON(path,{});if(validState(s))return s;}return {};}
function saveState(s,force) {mkdir('/tmp/easymode-traffic',0700);chmod('/tmp/easymode-traffic',0700);mkdir('/etc/easymode-traffic',0700);chmod('/etc/easymode-traffic',0700);while(length(sprintf('%J',s))>1500000 && length(keys(s.days))>1){delete s.days[sort(keys(s.days),(a,b)=>int(a)-int(b))[0]];s.capabilities.retention_trimmed=true;}if(force || s.time-int(s.checkpoint)>=1800){s.checkpoint=s.time;let previous=readJSON('/etc/easymode-traffic/history.json',{});if(previous.schema==1)atomic('/etc/easymode-traffic/history.backup.json',previous);atomic('/etc/easymode-traffic/history.json',s);}atomic('/tmp/easymode-traffic/state.json',s);}
function eraseHistory() {for(let p in ['/tmp/easymode-traffic/state.json','/etc/easymode-traffic/history.json','/etc/easymode-traffic/history.backup.json','/tmp/easymode-traffic/dns.log'])unlink(p);}
function resetBaseline(){let s=loadState();if(s.schema==1){s.boot='';s.previous={};s.flows={};saveState(s,false);}}
export {readJSON,atomic,settings,command,loadState,saveState,eraseHistory,resetBaseline};
