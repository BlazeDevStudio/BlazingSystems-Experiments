#!/bin/sh
umask 077
mkdir -p /tmp/easymode-traffic /etc/easymode-traffic
chmod 700 /tmp/easymode-traffic /etc/easymode-traffic
ucode /usr/share/easymode-traffic/dns.uc
trap 'ucode /usr/share/easymode-traffic/checkpoint.uc; ucode /usr/share/easymode-traffic/dns.uc stop; nft delete table inet easymode_traffic 2>/dev/null; exit 0' TERM INT
while :; do
 if [ -f /tmp/easymode-traffic/reconfigure ]; then
  rm -f /tmp/easymode-traffic/reconfigure
  ucode -e 'import {resetBaseline} from "/usr/share/easymode-traffic/runtime.uc"; resetBaseline();'
  ucode /usr/share/easymode-traffic/dns.uc
  nft delete table inet easymode_traffic 2>/dev/null
 fi
 if [ -f /tmp/easymode-traffic/delete ]; then
  rm -f /tmp/easymode-traffic/delete
  ucode -e 'import {eraseHistory} from "/usr/share/easymode-traffic/runtime.uc"; eraseHistory();'
  nft delete table inet easymode_traffic 2>/dev/null
 fi
 if ! ucode /usr/share/easymode-traffic/collect.uc 2>/tmp/easymode-traffic/error; then
  logger -t easymode-traffic 'Collection failed; private diagnostic in /tmp/easymode-traffic/error'
 fi
 interval=$(uci -q get easymode_traffic.main.interval)
 case "$interval" in 5|15|30|60) ;; *) interval=15 ;; esac
 mem=$(awk '/MemTotal:/ {print $2}' /proc/meminfo)
 [ "${mem:-0}" -ge 131072 ] || [ "$interval" -ge 15 ] || interval=15
 sleep "$interval" & wait $!
done
