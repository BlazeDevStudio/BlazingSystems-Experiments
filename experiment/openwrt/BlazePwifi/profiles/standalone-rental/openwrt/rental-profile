#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
. "${BP_AUTH_LIB:-/usr/lib/blazepwifi/auth.sh}"
bp_auth_init

action="$(bp_param action)"
require_role(){
  bp_auth_require_role "$1"
  rc=$?
  [ "$rc" -eq 0 ] && return 0
  [ "$rc" -eq 2 ] && bp_fail "insufficient role"
  bp_fail "unauthorized"
}
audit_json(){
  limit="$1"
  case "$limit" in ''|*[!0-9]*) limit=100;; esac
  [ "$limit" -le 200 ] 2>/dev/null || limit=200
  first=1
  printf '['
  tail -n "$limit" "$BP_AUDIT" 2>/dev/null | while IFS="$(printf '\t')" read -r at event user ip detail; do
    [ -n "$at" ] || continue
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"time":%s,"event":"%s","user":"%s","ip":"%s","detail":"%s"}' \
      "${at:-0}" "$(bp_json_escape "$event")" "$(bp_json_escape "$user")" "$(bp_json_escape "$ip")" "$(bp_json_escape "$detail")"
  done
  printf ']'
}
lan_ip(){
  ip="$(uci -q get network.lan.ipaddr || true)"
  [ -n "$ip" ] || ip="$(ip -4 addr show 2>/dev/null | awk '/inet / && $2 !~ /^127\./ {sub(/\/.*/,"",$2);print $2;exit}')"
  [ -n "$ip" ] || ip="router-ip"
  printf '%s' "$ip"
}

case "$action" in
  status)
    require_role viewer
    board="$(cat /tmp/sysinfo/board_name 2>/dev/null || echo unknown)"
    model="$(cat /tmp/sysinfo/model 2>/dev/null || cat /proc/device-tree/model 2>/dev/null | tr -d '\000' || echo unknown)"
    release="$(. /etc/openwrt_release 2>/dev/null; printf '%s' "${DISTRIB_RELEASE:-unknown}")"
    edition="$(uci -q get blazepwifi.main.edition || echo rental-standalone)"
    version="$(uci -q get blazepwifi.main.edition_version || echo 0.5.2-rental.2-rc.11)"
    upgrade="$(uci -q get blazepwifi.main.full_upgrade_available || echo 1)"
    free_kb="$(awk '/MemAvailable:/ {print $2; found=1} END{if(!found) print 0}' /proc/meminfo)"
    uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)"
    bp_json "$(printf '{"ok":true,"edition":"%s","version":"%s","full_upgrade_available":%s,"board":"%s","model":"%s","openwrt":"%s","mem_available_kb":%s,"uptime_seconds":%s}' \
      "$(bp_json_escape "$edition")" "$(bp_json_escape "$version")" "${upgrade:-1}" "$(bp_json_escape "$board")" "$(bp_json_escape "$model")" "$(bp_json_escape "$release")" "${free_kb:-0}" "${uptime:-0}")"
    ;;
  controller_binding)
    require_role admin
    key="$(uci -q get blazepwifi.main.vendo_key || true)"
    [ -n "$key" ] || bp_fail "controller binding key unavailable"
    ip="$(lan_ip)"
    bp_json "$(printf '{"ok":true,"server":"http://%s:4455","binding_key":"%s"}' "$(bp_json_escape "$ip")" "$(bp_json_escape "$key")")"
    ;;
  audit_list)
    require_role admin
    body="$(audit_json "$(bp_param limit)")"
    bp_json "$(printf '{"ok":true,"audit":%s}' "$body")"
    ;;
  *) bp_fail "unknown profile action" ;;
esac
