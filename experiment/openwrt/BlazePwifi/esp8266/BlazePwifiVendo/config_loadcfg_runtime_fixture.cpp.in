
#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <string>
using std::memset;
using std::strcpy;
/* PHX_CONFIG_STRUCTS */
/* PHX_CONFIG_CONSTANTS */

Config cfg{};
bool configStoreReady=false;

struct FakeSerial {
    std::string last;
    void println(const char *value) { last = value; }
};
FakeSerial Serial;

size_t strlcpy(char *destination, const char *source, size_t capacity) {
    const size_t length = std::strlen(source);
    if (capacity != 0) {
        const size_t copied = std::min(length, capacity - 1);
        std::memcpy(destination, source, copied);
        destination[copied] = '\0';
    }
    return length;
}

struct FakeEEPROM {
    unsigned char durable[sizeof(Config)]{};
    unsigned char staged[sizeof(Config)]{};
    bool begin_ok = true;
    bool read_ok = true;
    bool commit_ok = true;
    int begin_calls = 0;
    int read_calls = 0;
    int get_calls = 0;
    int put_calls = 0;
    int commit_calls = 0;

    bool beginChecked(size_t size) {
        (void)size;
        ++begin_calls;
        if (!begin_ok) return false;
        ++read_calls;
        return read_ok;
    }

    template <typename T>
    void get(int address, T &value) {
        (void)address;
        ++get_calls;
        std::memcpy(&value, durable, sizeof(T));
    }

    template <typename T>
    void put(int address, const T &value) {
        (void)address;
        ++put_calls;
        std::memcpy(staged, &value, sizeof(T));
    }

    bool commit() {
        ++commit_calls;
        if (!commit_ok) return false;
        std::memcpy(durable, staged, sizeof(durable));
        return true;
    }

    template <typename T>
    void seed(const T &value) {
        std::memset(durable, 0, sizeof(durable));
        std::memcpy(durable, &value, sizeof(T));
        std::memcpy(staged, durable, sizeof(durable));
        begin_ok = true;
        read_ok = true;
        commit_ok = true;
        configStoreReady = false;
        begin_calls = read_calls = get_calls = put_calls = commit_calls = 0;
    }

    void resetCounters() {
        begin_calls = read_calls = get_calls = put_calls = commit_calls = 0;
    }

    template <typename T>
    void readDurable(T &value) const {
        std::memcpy(&value, durable, sizeof(T));
    }
};
FakeEEPROM configEeprom;

void makeSetupPassword() {
    strlcpy(cfg.apPass, "fixture-pass-12", sizeof(cfg.apPass));
}

/* PHX_CONFIG_HELPERS */
/* PHX_CONFIG_RUNTIME_FUNCTIONS */

static void fillField(char *value, size_t capacity, const char *text) {
    std::memset(value, 0, capacity);
    strlcpy(value, text, capacity);
}

static Config makeCurrent() {
    Config value{};
    value.magic = MAGIC;
    fillField(value.ssid, sizeof(value.ssid), "current-ssid");
    fillField(value.pass, sizeof(value.pass), "current-pass");
    fillField(value.server, sizeof(value.server), "10.0.0.2");
    fillField(value.key, sizeof(value.key), "current-key");
    fillField(value.id, sizeof(value.id), "current-id");
    fillField(value.apPass, sizeof(value.apPass), "current-ap-pass");
    value.coinPin = 4;
    value.insertLedPin = 14;
    value.relayPin = 5;
    value.coinActiveLow = 1;
    return value;
}

static ConfigV1 makeLegacy() {
    ConfigV1 value{};
    value.magic = MAGIC_V1;
    fillField(value.ssid, sizeof(value.ssid), "legacy-ssid");
    fillField(value.pass, sizeof(value.pass), "legacy-pass");
    fillField(value.server, sizeof(value.server), "10.0.0.3");
    fillField(value.key, sizeof(value.key), "legacy-key");
    fillField(value.id, sizeof(value.id), "legacy-id");
    value.coinPin = 12;
    value.insertLedPin = 13;
    value.relayPin = 15;
    value.coinActiveLow = 0;
    return value;
}

static bool isDefaults() {
    return cfg.magic == MAGIC && cfg.ssid[0] == '\0' &&
           std::strcmp(cfg.server, "10.0.0.1") == 0 &&
           std::strcmp(cfg.id, "vendo-01") == 0 &&
           std::strcmp(cfg.apPass, "fixture-pass-12") == 0 &&
           cfg.coinPin == 4 && cfg.insertLedPin == 14 && cfg.relayPin == 5;
}

int main() {
    Config current = makeCurrent();
    configEeprom.seed(current);
    cfg = Config{};
    loadCfg();
    if (cfg.magic != MAGIC || std::strcmp(cfg.ssid, "current-ssid") != 0 ||
        std::strcmp(cfg.apPass, "current-ap-pass") != 0 ||
        configEeprom.put_calls != 0 || configEeprom.commit_calls != 0) return 1;
    std::cout << "EEPROM_LOADCFG_CURRENT_ACCEPT_PASS\n";

    struct CurrentField { char *value; size_t capacity; };
    for (int field = 0; field < 6; ++field) {
        current = makeCurrent();
        CurrentField fields[] = {
            {current.ssid, sizeof(current.ssid)},
            {current.pass, sizeof(current.pass)},
            {current.server, sizeof(current.server)},
            {current.key, sizeof(current.key)},
            {current.id, sizeof(current.id)},
            {current.apPass, sizeof(current.apPass)}
        };
        std::memset(fields[field].value, 'X', fields[field].capacity);
        configEeprom.seed(current);
        cfg = Config{};
        loadCfg();
        if (!isDefaults() || configEeprom.put_calls != 1 || configEeprom.commit_calls != 1) return 2;
    }
    std::cout << "EEPROM_LOADCFG_CURRENT_UNTERMINATED_REJECT_PASS fields=6/6\n";

    ConfigV1 legacy = makeLegacy();
    configEeprom.seed(legacy);
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    if (cfg.magic != MAGIC || std::strcmp(cfg.ssid, "legacy-ssid") != 0 ||
        std::strcmp(cfg.pass, "legacy-pass") != 0 ||
        std::strcmp(cfg.server, "10.0.0.3") != 0 ||
        std::strcmp(cfg.key, "legacy-key") != 0 ||
        std::strcmp(cfg.id, "legacy-id") != 0 ||
        std::strcmp(cfg.apPass, "fixture-pass-12") != 0 ||
        cfg.coinPin != 12 || cfg.insertLedPin != 13 || cfg.relayPin != 15 ||
        cfg.coinActiveLow != 0 || configEeprom.put_calls != 1 || configEeprom.commit_calls != 1 ||
        Serial.last != "Migrated BlazePwifi Vendo v1 configuration.") return 3;
    Config persisted{};
    configEeprom.readDurable(persisted);
    if (persisted.magic != MAGIC || std::strcmp(persisted.ssid, "legacy-ssid") != 0 ||
        std::strcmp(persisted.apPass, "fixture-pass-12") != 0) return 4;
    std::cout << "EEPROM_LOADCFG_LEGACY_MIGRATION_PASS\n";

    struct LegacyField { char *value; size_t capacity; };
    for (int field = 0; field < 5; ++field) {
        legacy = makeLegacy();
        LegacyField fields[] = {
            {legacy.ssid, sizeof(legacy.ssid)},
            {legacy.pass, sizeof(legacy.pass)},
            {legacy.server, sizeof(legacy.server)},
            {legacy.key, sizeof(legacy.key)},
            {legacy.id, sizeof(legacy.id)}
        };
        std::memset(fields[field].value, 'X', fields[field].capacity);
        configEeprom.seed(legacy);
        cfg = Config{};
        loadCfg();
        if (!isDefaults() || configEeprom.put_calls != 1 || configEeprom.commit_calls != 1) return 5;
    }
    std::cout << "EEPROM_LOADCFG_LEGACY_UNTERMINATED_REJECT_PASS fields=5/5\n";

    legacy = makeLegacy();
    configEeprom.seed(legacy);
    configEeprom.commit_ok = false;
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    ConfigV1 durableLegacy{};
    configEeprom.readDurable(durableLegacy);
    if (configEeprom.commit_calls != 1 || configEeprom.put_calls != 1 ||
        durableLegacy.magic != MAGIC_V1 ||
        std::strcmp(durableLegacy.ssid, "legacy-ssid") != 0 ||
        Serial.last != "CRITICAL: EEPROM configuration migration write failed; retrying on next boot.") return 6;
    configEeprom.commit_ok = true;
    configEeprom.resetCounters();
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    Config retried{};
    configEeprom.readDurable(retried);
    if (retried.magic != MAGIC || std::strcmp(retried.ssid, "legacy-ssid") != 0 ||
        configEeprom.commit_calls != 1 ||
        Serial.last != "Migrated BlazePwifi Vendo v1 configuration.") return 7;
    std::cout << "EEPROM_LOADCFG_MIGRATION_COMMIT_FAILURE_RETRY_PASS\n";

    current = makeCurrent();
    std::memset(current.ssid, 'X', sizeof(current.ssid));
    configEeprom.seed(current);
    configEeprom.commit_ok = false;
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    Config stillInvalid{};
    configEeprom.readDurable(stillInvalid);
    if (configEeprom.commit_calls != 1 || stillInvalid.magic != MAGIC ||
        stillInvalid.ssid[sizeof(stillInvalid.ssid) - 1] != 'X' ||
        Serial.last != "CRITICAL: EEPROM defaults write failed; setup remains available.") return 8;
    configEeprom.commit_ok = true;
    configEeprom.resetCounters();
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    Config repaired{};
    configEeprom.readDurable(repaired);
    if (!isDefaults() || repaired.magic != MAGIC || repaired.ssid[0] != '\0' ||
        configEeprom.commit_calls != 1) return 9;
    std::cout << "EEPROM_LOADCFG_DEFAULT_COMMIT_FAILURE_RETRY_PASS\n";


    current = makeCurrent();
    configEeprom.seed(current);
    configEeprom.begin_ok = false;
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    Config durableAfterBeginFailure{};
    configEeprom.readDurable(durableAfterBeginFailure);
    if (configStoreReady || !isDefaults() || configEeprom.begin_calls != 1 ||
        configEeprom.get_calls != 0 || configEeprom.put_calls != 0 || configEeprom.commit_calls != 0 ||
        durableAfterBeginFailure.magic != MAGIC ||
        std::strcmp(durableAfterBeginFailure.ssid, "current-ssid") != 0 ||
        Serial.last != "CRITICAL: EEPROM initialization failed; configuration unavailable; coin intake remains denied.") return 10;
    std::cout << "EEPROM_LOADCFG_BEGIN_FAILURE_FAIL_CLOSED_PASS\n";

    configEeprom.begin_ok = true;
    cfg = makeCurrent();
    if (!saveCfg() || !configStoreReady || configEeprom.begin_calls != 2 ||
        configEeprom.get_calls != 0 || configEeprom.put_calls != 1 || configEeprom.commit_calls != 1) return 11;
    Config recoveredAfterBeginFailure{};
    configEeprom.readDurable(recoveredAfterBeginFailure);
    if (recoveredAfterBeginFailure.magic != MAGIC ||
        std::strcmp(recoveredAfterBeginFailure.ssid, "current-ssid") != 0) return 12;
    std::cout << "EEPROM_LOADCFG_BEGIN_FAILURE_RECOVERY_PASS\n";

    current = makeCurrent();
    configEeprom.seed(current);
    configEeprom.read_ok = false;
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    Config durableAfterReadFailure{};
    configEeprom.readDurable(durableAfterReadFailure);
    if (configStoreReady || !isDefaults() || configEeprom.begin_calls != 1 ||
        configEeprom.read_calls != 1 || configEeprom.get_calls != 0 ||
        configEeprom.put_calls != 0 || configEeprom.commit_calls != 0 ||
        durableAfterReadFailure.magic != MAGIC ||
        std::strcmp(durableAfterReadFailure.ssid, "current-ssid") != 0) return 14;
    std::cout << "EEPROM_LOADCFG_FLASH_READ_FAILURE_FAIL_CLOSED_PASS\\n";

    configEeprom.read_ok = true;
    cfg = makeCurrent();
    if (!saveCfg() || !configStoreReady || configEeprom.begin_calls != 2 ||
        configEeprom.read_calls != 2 || configEeprom.put_calls != 1 ||
        configEeprom.commit_calls != 1) return 15;
    Config recoveredAfterReadFailure{};
    configEeprom.readDurable(recoveredAfterReadFailure);
    if (recoveredAfterReadFailure.magic != MAGIC ||
        std::strcmp(recoveredAfterReadFailure.ssid, "current-ssid") != 0) return 16;
    std::cout << "EEPROM_LOADCFG_FLASH_READ_FAILURE_RECOVERY_PASS\\n";

    configEeprom.resetCounters();
    configStoreReady = false;
    cfg = Config{};
    Serial.last.clear();
    loadCfg();
    if (!configStoreReady || cfg.magic != MAGIC ||
        std::strcmp(cfg.ssid, "current-ssid") != 0 ||
        configEeprom.begin_calls != 1 || configEeprom.get_calls != 1 ||
        configEeprom.put_calls != 0 || configEeprom.commit_calls != 0) return 13;

    std::cout << "EEPROM_LOADCFG_RUNTIME_PASS current=1/1 current_invalid=6/6 legacy=1/1 legacy_invalid=5/5 commit_retry=2/2 begin_failure=1/1 flash_read_failure=1/1\n";
    return 0;
}