#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
. "${BP_AUTH_LIB:-/usr/lib/blazepwifi/auth.sh}"
. "${BP_RENTAL_LIB:-/usr/lib/blazepwifi/rental.sh}"
. "${BP_RENTAL_POLICY_LIB:-/usr/lib/blazepwifi/rental_policy.sh}"
[ ! -r "${BP_RENTAL_UPDATE_LIB:-/usr/lib/blazepwifi/rental_update.sh}" ] || . "${BP_RENTAL_UPDATE_LIB:-/usr/lib/blazepwifi/rental_update.sh}"
bp_rental_init
bp_rental_policy_v2_init

action="$(bp_param action)"
nonce="$(bp_param nonce)"
sig="$(bp_param sig)"
now="$(bp_now)"
[ -n "$nonce" ] && [ -n "$sig" ] || bp_fail "missing authentication"

case "$action" in
  enroll)
    eid="$(bp_param enroll_id)"
    printf '%s' "$eid" | grep -Eq '^[0-9a-f]{12}$' || bp_fail "invalid enrollment id"
    line="$(bp_rental_enroll_lookup "$eid")"
    [ -n "$line" ] || bp_fail "enrollment invalid or used"
    IFS="$(printf '\t')" read -r stored_eid secret expiry label redeemed_nonce redeemed_did redeemed_secret <<EOF
$line
EOF
    [ "$expiry" -ge "$now" ] 2>/dev/null || { bp_rental_enroll_consume "$eid"; bp_fail "enrollment expired"; }
    token="$eid.$secret"
    expected="$(bp_rental_hmac "$token" "enroll|$nonce|$token")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"

    # Claim first, then materialize the device. If the response or device write
    # is interrupted, the same request nonce can reconstruct the exact identity.
    bp_lock || bp_fail "enrollment busy"
    line="$(bp_rental_enroll_lookup "$eid")"
    [ -n "$line" ] || { bp_unlock; bp_fail "enrollment invalid or used"; }
    IFS="$(printf '\t')" read -r stored_eid secret expiry label redeemed_nonce redeemed_did redeemed_secret <<EOF
$line
EOF
    [ "$expiry" -ge "$now" ] 2>/dev/null || {
      bp_rental_enroll_consume "$eid"
      bp_unlock
      bp_fail "enrollment expired"
    }

    if [ -n "$redeemed_nonce" ]; then
      [ "$redeemed_nonce" = "$nonce" ] || {
        bp_unlock
        bp_fail "enrollment already claimed"
      }
      printf '%s' "$redeemed_did" | grep -Eq '^[0-9a-f]{24}$' || {
        bp_unlock
        bp_fail "enrollment redemption corrupted"
      }
      printf '%s' "$redeemed_secret" | grep -Eq '^[0-9a-f]{48}$' || {
        bp_unlock
        bp_fail "enrollment redemption corrupted"
      }
      did="$redeemed_did"
      dsecret="$redeemed_secret"
      existing="$(bp_rental_device_line "$did")"
      if [ -n "$existing" ]; then
        existing_secret="$(printf '%s' "$existing" | cut -f2)"
        [ "$existing_secret" = "$dsecret" ] || {
          bp_unlock
          bp_fail "enrollment device identity conflict"
        }
      else
        bp_rental_device_write "$did" "$dsecret" 0 "${label:-Rental phone}" "$now" || {
          bp_unlock
          bp_fail "enrollment device recovery failed"
        }
      fi
      bp_rental_policy_ensure "$did" || {
        bp_unlock
        bp_fail "enrollment policy recovery failed"
      }
      reused=true
    else
      did="$(bp_rental_hex 12)"
      dsecret="$(bp_rental_hex 24)"
      bp_rental_enroll_mark_redeemed "$eid" "$nonce" "$did" "$dsecret" || {
        bp_unlock
        bp_fail "enrollment redemption write failed"
      }
      bp_durable_sync || {
        bp_unlock
        bp_fail "enrollment redemption sync failed"
      }
      bp_rental_device_write "$did" "$dsecret" 0 "${label:-Rental phone}" "$now" || {
        bp_unlock
        bp_fail "enrollment device write failed"
      }
      bp_rental_policy_ensure "$did" || {
        bp_unlock
        bp_fail "enrollment policy write failed"
      }
      reused=false
    fi

    verified="$(bp_rental_device_line "$did")"
    [ -n "$verified" ] && [ "$(printf '%s' "$verified" | cut -f2)" = "$dsecret" ] || {
      bp_unlock
      bp_fail "enrollment device verification failed"
    }
    bp_unlock

    server_ms=$((now*1000))
    lease_ms=$server_ms
    enroll_canonical="enroll_response|$nonce|$did|$dsecret|$server_ms|$lease_ms|$reused"
    enroll_sig="$(bp_rental_hmac "$token" "$enroll_canonical")" || bp_fail "rental crypto unavailable"
    bp_json "$(printf '{"ok":true,"reused":%s,"device_id":"%s","device_secret":"%s","server_time_ms":%s,"lease_until_ms":%s,"enroll_sig":"%s"}' "$reused" "$did" "$dsecret" "$server_ms" "$lease_ms" "$enroll_sig")"
    ;;
  status|policy_get)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"
    [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    lease="$(printf '%s' "$line" | cut -f3)"
    label="$(printf '%s' "$line" | cut -f4)"
    expected="$(bp_rental_hmac "$secret" "$action|$nonce|$secret")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"
    # Never disclose/use a partially committed paid lease while any financial
    # transaction is quarantined. Exact rental retries recover through Vendo.
    [ ! -e "$BP_PAID_UNCERTAIN" ] && [ ! -L "$BP_PAID_UNCERTAIN" ] ||
      bp_fail "paid state uncertain; operator reconciliation required"

    # Once the device proves possession of its permanent secret, the temporary
    # retry-redemption record is no longer needed. Missing record is a no-op.
    bp_lock || bp_fail "enrollment cleanup busy"
    if bp_rental_enroll_consume_device "$did"; then
      bp_durable_sync || {
        bp_unlock
        bp_fail "enrollment cleanup sync failed"
      }
    else
      cleanup_rc=$?
      [ "$cleanup_rc" -eq 3 ] || {
        bp_unlock
        bp_fail "enrollment cleanup failed"
      }
    fi
    bp_unlock

    inventory="$(bp_param inventory)"
    [ -z "$inventory" ] || bp_rental_inventory_write "$did" "$inventory" || bp_fail "invalid app inventory"
    # A heartbeat is NOT a paid transaction. Previously, the status request
    # read a paid lease before enrollment/inventory work, then wrote that
    # STALE lease back solely to update last_seen. A coin credit landing
    # between those steps could be lost permanently. Only update volatile
    # presence metadata, then re-read authoritative current paid lease.
    live="$(bp_rental_device_line "$did")"
    [ -n "$live" ] || bp_fail "rental identity missing after authentication"
    live_secret="$(printf '%s' "$live" | cut -f2)"
    [ "$live_secret" = "$secret" ] || bp_fail "rental identity changed; re-enroll securely"
    lease="$(printf '%s' "$live" | cut -f3)"
    case "$lease" in ''|*[!0-9]*) bp_fail "invalid paid rental lease; operator reconciliation required";; esac
    bp_rental_seen_update "$did" "$now" ||
      bp_fail "rental presence update failed; retry status"

    v2="$(bp_rental_policy_v2_get "$did")" || bp_fail "policy unavailable"
    IFS="$(printf '\t')" read -r _did rev updated by mode allowed hidden preferred timer_mode timer_toggle quick notifications gesture_type gesture_value salt hash rounds grace caps <<EOF
$v2
EOF
    [ "$allowed" = "-" ] && allowed=""
    [ "$hidden" = "-" ] && hidden=""
    [ "$preferred" = "-" ] && preferred=""
    [ "$quick" = "-" ] && quick=""
    [ "$salt" = "-" ] && salt=""
    [ "$hash" = "-" ] && hash=""

    per="$(bp_cfg rental_seconds_per_pulse)"; [ -n "$per" ] || per=600
    server_ms=$((now*1000))
    report_lease="${lease:-0}"
    [ "$report_lease" -ge "$now" ] 2>/dev/null || report_lease="$now"
    lease_ms=$((report_lease*1000))

    legacy="$did|$nonce|$server_ms|$lease_ms|$allowed|$salt|$hash|$rounds|$preferred|$per"
    legacy_sig="$(bp_rental_hmac "$secret" "$legacy")" || bp_fail "rental crypto unavailable"
    v2canonical="v2|$did|$nonce|$server_ms|$lease_ms|$rev|$mode|$allowed|$hidden|$salt|$hash|$rounds|$preferred|$per"
    v2sig="$(bp_rental_hmac "$secret" "$v2canonical")" || bp_fail "rental crypto unavailable"
    v3canonical="v3|$did|$nonce|$server_ms|$lease_ms|$rev|$mode|$allowed|$hidden|$salt|$hash|$rounds|$preferred|$per|$timer_mode|$timer_toggle|$quick|$notifications|$gesture_type|$gesture_value|$grace"
    v3sig="$(bp_rental_hmac "$secret" "$v3canonical")" || bp_fail "rental crypto unavailable"

    coin_expires_ms=0
    coin_vendo=""
    coin_received_pulses=0
    coin_received_cents=0
    for target_file in "$BP_TARGET_DIR"/*.tsv; do
      [ -f "$target_file" ] || continue
      IFS="$(printf '\t')" read -r target_device target_mac target_nonce target_expires target_vendo target_kind < "$target_file"
      [ "$target_device" = "$did" ] || continue
      [ "${target_kind:-hotspot}" = rental ] || continue
      if [ "${target_expires:-0}" -gt "$now" ] 2>/dev/null; then
        coin_expires_ms=$((target_expires*1000))
        coin_vendo="$target_vendo"
        progress_file="$BP_TARGET_DIR/$target_vendo.progress"
        [ -r "$progress_file" ] && coin_received_pulses="$(cat "$progress_file" 2>/dev/null || echo 0)"
        case "$coin_received_pulses" in ''|*[!0-9]*) coin_received_pulses=0;; esac
        unit="$(bp_cfg pulse_value_centavos)"; [ -n "$unit" ] || unit=100
        case "$unit" in ''|*[!0-9]*) unit=100;; esac
        coin_received_cents=$((unit*coin_received_pulses))
      fi
      break
    done
    coin_canonical="coin_window|$did|$server_ms|$coin_expires_ms|$coin_vendo|$coin_received_pulses|$coin_received_cents"
    coin_sig="$(bp_rental_hmac "$secret" "$coin_canonical")" || bp_fail "rental crypto unavailable"

    if command -v bp_rental_update_json >/dev/null 2>&1; then update_meta="$(bp_rental_update_json)"; else update_meta='{"available":false}'; fi

    bp_json "$(printf '{"ok":true,"device_id":"%s","server_time_ms":%s,"lease_until_ms":%s,"coin_window_expires_ms":%s,"coin_window_vendo":"%s","coin_received_pulses":%s,"coin_received_cents":%s,"coin_window_sig":"%s","policy_revision":%s,"launcher_mode":"%s","allowed_packages":"%s","hidden_packages":"%s","admin_salt":"%s","admin_hash":"%s","admin_rounds":%s,"preferred_vendo":"%s","rental_seconds_per_pulse":%s,"timer_mode":"%s","timer_user_toggle":%s,"quick_controls":"%s","notifications_enabled":%s,"admin_gesture_type":"%s","admin_gesture_value":"%s","offline_grace":%s,"policy_sig":"%s","policy_sig_v2":"%s","policy_sig_v3":"%s","update":%s}'       "$did" "$server_ms" "$lease_ms" "$coin_expires_ms" "$(bp_json_escape "$coin_vendo")" "$coin_received_pulses" "$coin_received_cents" "$coin_sig" "${rev:-1}" "$(bp_json_escape "$mode")" "$(bp_json_escape "$allowed")" "$(bp_json_escape "$hidden")"       "$(bp_json_escape "$salt")" "$(bp_json_escape "$hash")" "${rounds:-4096}" "$(bp_json_escape "$preferred")" "$per"       "$(bp_json_escape "$timer_mode")" "${timer_toggle:-1}" "$(bp_json_escape "$quick")" "${notifications:-1}"       "$(bp_json_escape "$gesture_type")" "$(bp_json_escape "$gesture_value")" "${grace:-0}" "$legacy_sig" "$v2sig" "$v3sig" "$update_meta")"
    ;;
  policy_patch)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"; [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    expected_rev="$(bp_param expected_revision)"
    mode_new="$(bp_param launcher_mode)"; [ -n "$mode_new" ] || mode_new="@keep"
    allowed_new="$(bp_param allowed_packages)"; [ -n "$allowed_new" ] || allowed_new="@keep"
    hidden_new="$(bp_param hidden_packages)"; [ -n "$hidden_new" ] || hidden_new="@keep"
    preferred_new="$(bp_param preferred_vendo)"; [ -n "$preferred_new" ] || preferred_new="@keep"
    timer_toggle_new="$(bp_param timer_user_toggle)"; [ -n "$timer_toggle_new" ] || timer_toggle_new="@keep"
    notifications_new="$(bp_param notifications_enabled)"; [ -n "$notifications_new" ] || notifications_new="@keep"
    quick_new="$(bp_param quick_controls)"; [ -n "$quick_new" ] || quick_new="@keep"
    gesture_new="$(bp_param admin_gesture_value)"; [ -n "$gesture_new" ] || gesture_new="@keep"
    admin_password="$(bp_param admin_password)"; [ -n "$admin_password" ] || admin_password="@keep"

    canonical="policy_patch|$nonce|$did|$expected_rev|$mode_new|$allowed_new|$hidden_new|$preferred_new|$timer_toggle_new|$notifications_new|$quick_new|$gesture_new|$admin_password"
    expected="$(bp_rental_hmac "$secret" "$canonical")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"

    if newrev="$(bp_rental_policy_v2_patch "$did" "$expected_rev" device "$mode_new" "$allowed_new" "$hidden_new" "$preferred_new" "$timer_toggle_new" "$notifications_new" "$quick_new" "$gesture_new" "$admin_password")"; then
      policy_json="$(bp_rental_policy_v2_json "$did")" || bp_fail "policy unavailable"
      bp_json "{\"ok\":true,\"policy_revision\":$newrev,\"policy\":$policy_json}"
    else
      rc=$?
      [ "$rc" -eq 4 ] && {
        current="$(bp_rental_policy_v2_get "$did" | cut -f2)"
        bp_json "{\"ok\":false,\"error\":\"stale policy revision\",\"current_revision\":${current:-0}}"
        exit 0
      }
      [ "$rc" -eq 2 ] && bp_fail "invalid policy patch"
      bp_fail "policy write failed"
    fi
    ;;
  inventory_update|device_capabilities)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"; [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    payload="$(bp_param inventory)"
    [ "$action" = device_capabilities ] && payload="$(bp_param capabilities)"
    expected="$(bp_rental_hmac "$secret" "$action|$nonce|$payload|$secret")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"
    if [ "$action" = inventory_update ]; then
      bp_rental_inventory_write "$did" "$payload" || bp_fail "invalid app inventory"
    fi
    bp_json '{"ok":true}'
    ;;
  coin_start)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"
    [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    expected="$(bp_rental_hmac "$secret" "coin_start|$nonce|$secret")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"
    bp_time_sane "$now" || bp_fail "router clock not synchronized"
    policy="$(bp_rental_policy_line "$did")"
    preferred="$(printf '%s' "$policy" | cut -f6)"
    [ "$preferred" = "-" ] && preferred=""
    requested_vendo="$(bp_param vendo)"
    [ -n "$requested_vendo" ] || requested_vendo="$preferred"
    window="$(bp_cfg coin_window)"
    [ -n "$window" ] || window=120
    case "$window" in ''|*[!0-9]*) window=120;; esac
    [ "$window" -ge 10 ] 2>/dev/null && [ "$window" -le 600 ] 2>/dev/null || window=120

    # A Rental device may own only one live coin reservation. Repeated starts
    # (double tap/network retry) return the existing target instead of replacing
    # its nonce or resetting accepted-coin progress.
    bp_lock || bp_fail "accounting busy"
    for active_file in "$BP_TARGET_DIR"/*.tsv; do
      [ -f "$active_file" ] || continue
      IFS="$(printf '\t')" read -r active_device active_mac active_nonce active_expires active_vendo active_kind < "$active_file"
      [ "$active_device" = "$did" ] || continue
      [ "${active_kind:-hotspot}" = rental ] || continue
      if ! [ "${active_expires:-0}" -gt "$now" ] 2>/dev/null; then
        rm -f "$active_file" "$BP_TARGET_DIR/$active_vendo.progress"
        continue
      fi
      progress_file="$BP_TARGET_DIR/$active_vendo.progress"
      received_pulses=0
      [ -r "$progress_file" ] && received_pulses="$(cat "$progress_file" 2>/dev/null || echo 0)"
      case "$received_pulses" in ''|*[!0-9]*) received_pulses=0;; esac
      unit="$(bp_cfg pulse_value_centavos)"; [ -n "$unit" ] || unit=100
      case "$unit" in ''|*[!0-9]*) unit=100;; esac
      received_cents=$((unit*received_pulses))
      bp_unlock
      server_ms=$((now*1000))
      expires_ms=$((active_expires*1000))
      coin_canonical="coin_window|$did|$server_ms|$expires_ms|$active_vendo|$received_pulses|$received_cents"
      coin_sig="$(bp_rental_hmac "$secret" "$coin_canonical")" || bp_fail "rental crypto unavailable"
      bp_json "$(printf '{"ok":true,"reused":true,"vendo":"%s","target_nonce":"%s","server_time_ms":%s,"expires_ms":%s,"received_pulses":%s,"received_cents":%s,"coin_window_sig":"%s"}' "$(bp_json_escape "$active_vendo")" "$(bp_json_escape "$active_nonce")" "$server_ms" "$expires_ms" "$received_pulses" "$received_cents" "$coin_sig")"
      exit 0
    done

    vendo="$requested_vendo"
    [ -n "$vendo" ] || vendo="$(bp_choose_vendo 2>/dev/null || true)"
    [ -n "$vendo" ] || { bp_unlock; bp_fail "select a controller or wait for one to come online"; }
    printf '%s' "$vendo" | grep -Eq '^[A-Za-z0-9._-]{1,48}$' || { bp_unlock; bp_fail "invalid controller"; }
    target_file="$BP_TARGET_DIR/$vendo.tsv"
    if [ -f "$target_file" ]; then
      IFS="$(printf '\t')" read -r old_device old_mac old_nonce old_expires old_vendo old_kind < "$target_file"
      old_kind="${old_kind:-hotspot}"
      if [ "${old_expires:-0}" -gt "$now" ] 2>/dev/null; then
        bp_unlock
        bp_fail "selected controller is busy"
      fi
      rm -f "$target_file" "$BP_TARGET_DIR/$vendo.progress"
    fi

    expires=$((now+window))
    target_nonce="$(hexdump -n 8 -e '8/1 "%02x"' /dev/urandom 2>/dev/null || printf '%s' "$now")"
    target_tmp="$BP_TARGET_DIR/.$vendo.$(bp_tmp_suffix)"
    printf '%s\t-\t%s\t%s\t%s\trental\n' "$did" "$target_nonce" "$expires" "$vendo" > "$target_tmp"
    chmod 600 "$target_tmp"
    mv "$target_tmp" "$target_file"
    printf '0\n' > "$BP_TARGET_DIR/$vendo.progress"
    chmod 600 "$BP_TARGET_DIR/$vendo.progress"
    bp_durable_sync
    bp_unlock

    server_ms=$((now*1000))
    expires_ms=$((expires*1000))
    coin_canonical="coin_window|$did|$server_ms|$expires_ms|$vendo|0|0"
    coin_sig="$(bp_rental_hmac "$secret" "$coin_canonical")" || bp_fail "rental crypto unavailable"
    bp_json "$(printf '{"ok":true,"reused":false,"vendo":"%s","target_nonce":"%s","server_time_ms":%s,"expires_ms":%s,"received_pulses":0,"received_cents":0,"coin_window_sig":"%s"}' "$(bp_json_escape "$vendo")" "$target_nonce" "$server_ms" "$expires_ms" "$coin_sig")"
    ;;
  coin_stop)
    did="$(bp_param device_id)"
    printf '%s' "$did" | grep -Eq '^[0-9a-f]{24}$' || bp_fail "invalid device id"
    line="$(bp_rental_device_line "$did")"
    [ -n "$line" ] || bp_fail "unknown device"
    secret="$(printf '%s' "$line" | cut -f2)"
    expected="$(bp_rental_hmac "$secret" "coin_stop|$nonce|$secret")" || bp_fail "rental crypto unavailable"
    [ "$sig" = "$expected" ] || bp_fail "authentication failed"
    bp_lock || bp_fail "accounting busy"
    removed=0
    received_pulses=0
    received_cents=0
    for target_file in "$BP_TARGET_DIR"/*.tsv; do
      [ -f "$target_file" ] || continue
      IFS="$(printf '\t')" read -r target_device target_mac target_nonce target_expires target_vendo target_kind < "$target_file"
      [ "$target_device" = "$did" ] || continue
      [ "${target_kind:-hotspot}" = rental ] || continue
      progress_file="$BP_TARGET_DIR/$target_vendo.progress"
      [ -r "$progress_file" ] && received_pulses="$(cat "$progress_file" 2>/dev/null || echo 0)"
      case "$received_pulses" in ''|*[!0-9]*) received_pulses=0;; esac
      unit="$(bp_cfg pulse_value_centavos)"; [ -n "$unit" ] || unit=100
      case "$unit" in ''|*[!0-9]*) unit=100;; esac
      received_cents=$((unit*received_pulses))
      rm -f "$target_file" "$progress_file"
      removed=1
    done
    [ "$removed" = 1 ] && bp_durable_sync
    bp_unlock
    server_ms=$((now*1000))
    coin_canonical="coin_window|$did|$server_ms|0||$received_pulses|$received_cents"
    coin_sig="$(bp_rental_hmac "$secret" "$coin_canonical")" || bp_fail "rental crypto unavailable"
    bp_json "$(printf '{"ok":true,"server_time_ms":%s,"expires_ms":0,"received_pulses":%s,"received_cents":%s,"coin_window_sig":"%s"}' "$server_ms" "$received_pulses" "$received_cents" "$coin_sig")"
    ;;
  *) bp_fail "unknown rental action" ;;
esac
