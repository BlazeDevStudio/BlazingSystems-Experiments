#!/bin/sh
. "${BP_LIB:-/usr/lib/blazepwifi/common.sh}"
. "${BP_AUTH_LIB:-/usr/lib/blazepwifi/auth.sh}"
. "${BP_CONFIG_LIB:-/usr/lib/blazepwifi/config.sh}"
. "${BP_RENTAL_LIB:-/usr/lib/blazepwifi/rental.sh}"
. "${BP_RENTAL_POLICY_LIB:-/usr/lib/blazepwifi/rental_policy.sh}"
[ ! -r "${BP_RENTAL_UPDATE_LIB:-/usr/lib/blazepwifi/rental_update.sh}" ] || . "${BP_RENTAL_UPDATE_LIB:-/usr/lib/blazepwifi/rental_update.sh}"
. "${BP_CONTROLLER_LIB:-/usr/lib/blazepwifi/controller.sh}"
. "${BP_MEMBER_LIB:-/usr/lib/blazepwifi/member.sh}"
. "${BP_MEMBER_MIGRATION_LIB:-/usr/lib/blazepwifi/member_migration.sh}"
[ ! -r "${BP_UPDATE_LIB:-/usr/lib/blazepwifi/update.sh}" ] || . "${BP_UPDATE_LIB:-/usr/lib/blazepwifi/update.sh}"
. "${BP_CONSOLE_OPS_LIB:-/usr/lib/blazepwifi/console_ops.sh}"
. "${BP_REMOTE_APPLY_LIB:-/usr/lib/blazepwifi/remote_apply.sh}"
bp_init_dirs
admin_port="$(bp_cfg admin_port)"; [ -n "$admin_port" ] || admin_port=8443
[ "${SERVER_PORT:-}" = "$admin_port" ] || bp_fail "admin API requires HTTPS"
action="$(bp_param action)"; now="$(bp_now)"
bp_rental_init
bp_rental_policy_v2_init
bp_member_init

bp_admin_server_url() {
  supplied="$(bp_param server_url)"
  if [ -n "$supplied" ]; then
    case "$supplied" in
      http://*|https://*) ;;
      *) return 1 ;;
    esac
    printf '%s' "$supplied" | grep -q '[[:space:][:cntrl:]]' && return 1
    [ "$(printf '%s' "$supplied" | wc -c)" -le 256 ] || return 1
    printf '%s' "$supplied" | sed 's:/*$::'
    return 0
  fi
  host="${HTTP_HOST:-}"
  [ -n "$host" ] || host="${SERVER_NAME:-blazepwifi.local}:$admin_port"
  printf 'https://%s' "$host"
}

bp_admin_cert_sha256() {
  cert="${BP_ADMIN_CERT:-/etc/uhttpd.crt}"
  [ -r "$cert" ] || return 1
  command -v base64 >/dev/null 2>&1 || return 1
  command -v sha256sum >/dev/null 2>&1 || return 1
  digest="$(awk '/-----BEGIN CERTIFICATE-----/{on=1;next}/-----END CERTIFICATE-----/{exit}on{gsub(/[[:space:]]/,"");printf "%s",$0}' "$cert" | base64 -d 2>/dev/null | sha256sum 2>/dev/null | awk '{print $1}')"
  [ "$(printf '%s' "$digest" | wc -c)" -eq 64 ] || return 1
  case "$digest" in *[!0-9a-fA-F]*) return 1;; esac
  printf '%s' "$digest" | tr A-F a-f
}

bp_admin_local_cert_pin() {
  server="$1"
  host="${HTTP_HOST:-}"
  [ -n "$host" ] || host="${SERVER_NAME:-blazepwifi.local}:$admin_port"
  [ "$server" = "https://$host" ] || { printf ''; return 0; }
  bp_admin_cert_sha256
}
bp_admin_binding_payload() {
  server="$1"; token="$2"; label="$3"; cert_pin="$4"
  printf '{"server_url":"%s","enrollment_token":"%s","device_name":"%s","server_cert_sha256":"%s"}' \
    "$(bp_json_escape "$server")" "$(bp_json_escape "$token")" "$(bp_json_escape "$label")" "$(bp_json_escape "$cert_pin")"
}

bp_admin_sha256_b64url() {
  hex="$(printf '%s' "$1" | tr A-F a-f)"
  [ "$(printf '%s' "$hex" | wc -c)" -eq 64 ] || return 1
  case "$hex" in *[!0-9a-f]*) return 1;; esac
  awk -v h="$hex" '
    function nib(c) { return index("0123456789abcdef",c)-1 }
    function byte_at(pos) { return nib(substr(h,pos,1))*16+nib(substr(h,pos+1,1)) }
    BEGIN {
      alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
      n=length(h)
      for(pos=1;pos<=n;pos+=6){
        b1=byte_at(pos)
        have2=(pos+2<=n)
        have3=(pos+4<=n)
        b2=have2?byte_at(pos+2):0
        b3=have3?byte_at(pos+4):0
        c1=int(b1/4)
        c2=(b1%4)*16+int(b2/16)
        printf "%s%s",substr(alphabet,c1+1,1),substr(alphabet,c2+1,1)
        if(have2){
          c3=(b2%16)*4+int(b3/64)
          printf "%s",substr(alphabet,c3+1,1)
        }
        if(have3){
          c4=b3%64
          printf "%s",substr(alphabet,c4+1,1)
        }
      }
    }
  '
}

bp_admin_provisioning_payload() {
  server="$1"; token="$2"; label="$3"; apk_url="$4"; checksum="$5"; version_code="$6"; cert_pin="$7"
  printf '{"android.app.extra.PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME":"com.blazesystems.blazerental/.BlazeDeviceAdminReceiver","android.app.extra.PROVISIONING_DEVICE_ADMIN_PACKAGE_DOWNLOAD_LOCATION":"%s","android.app.extra.PROVISIONING_DEVICE_ADMIN_PACKAGE_CHECKSUM":"%s","android.app.extra.PROVISIONING_DEVICE_ADMIN_MINIMUM_VERSION_CODE":%s,"android.app.extra.PROVISIONING_ADMIN_EXTRAS_BUNDLE":{"server_url":"%s","enrollment_token":"%s","device_name":"%s","server_cert_sha256":"%s"}}' \
    "$(bp_json_escape "$apk_url")" "$(bp_json_escape "$checksum")" "${version_code:-0}" \
    "$(bp_json_escape "$server")" "$(bp_json_escape "$token")" "$(bp_json_escape "$label")" "$(bp_json_escape "$cert_pin")"
}
require_role() {
	need="$1"
	bp_auth_require_role "$need"
	rc=$?
	[ "$rc" -eq 0 ] && return 0
	[ "$rc" -eq 2 ] && bp_fail "insufficient role"
	bp_fail "unauthorized"
}

bp_admin_is_remote_listener() {
  remote_listener="$(bp_remote_runtime_get wg_listener 2>/dev/null || true)"
  remote_ip="${remote_listener%:*}"
  [ -n "$remote_listener" ] && [ -n "$remote_ip" ] || return 1
  [ "${SERVER_ADDR:-}" = "$remote_ip" ]
}

require_remote_terminal_permission() {
  if bp_admin_is_remote_listener; then
    [ "$(bp_remote_get terminal 0)" = 1 ] || bp_fail "Remote Terminal permission is disabled"
  fi
}

case "$action" in
  rental_enroll_create|rental_device_add|rental_device_qr|rental_binding_qr)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    bp_rental_init
    label="$(bp_param label)"; [ -n "$label" ] || label="Rental phone"
    bp_lock || bp_fail "enrollment registry busy"
    token="$(bp_rental_enroll_create "$label" 600)" || {
      bp_unlock
      bp_fail "enrollment token storage failed; QR not issued"
    }
    bp_unlock
    printf '%s' "$token" | LC_ALL=C grep -Eq '^[a-f0-9]{12}\.[a-f0-9]{36}$' ||
      bp_fail "invalid generated enrollment token; QR not issued"
    server="$(bp_admin_server_url)" || bp_fail "invalid server url"
    cert_pin="$(bp_admin_local_cert_pin "$server")" || bp_fail "unable to fingerprint local admin certificate"
    qr_payload="$(bp_admin_binding_payload "$server" "$token" "$label" "$cert_pin")"
    bp_auth_audit rental_binding_qr "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$(printf '%s' "$label" | cut -c1-64)"
    bp_json "$(printf '{"ok":true,"qr_type":"binding","enrollment_token":"%s","expires_seconds":600,"server_url":"%s","device_name":"%s","qr_payload":"%s"}' \
      "$(bp_json_escape "$token")" "$(bp_json_escape "$server")" "$(bp_json_escape "$label")" "$(bp_json_escape "$qr_payload")")"
    ;;
  rental_provisioning_qr)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    command -v bp_rental_update_line >/dev/null 2>&1 || bp_fail "rental update subsystem unavailable"
    bp_rental_init
    label="$(bp_param label)"; [ -n "$label" ] || label="Rental phone"
    server="$(bp_admin_server_url)" || bp_fail "invalid server url"
    case "$server" in https://*) ;; *) bp_fail "Device Owner provisioning server URL must use HTTPS";; esac
    update_line="$(bp_rental_update_line)"
    [ -n "$update_line" ] || bp_fail "publish the signed BlazeRental update channel before provisioning"
    IFS="$(printf '\t')" read -r apk_version apk_code apk_url apk_sha rollback_version rollback_code rollback_url rollback_sha <<EOF
$update_line
EOF
    case "$apk_code" in ''|*[!0-9]*) bp_fail "invalid published BlazeRental version code";; esac
    [ "$apk_code" -gt 0 ] 2>/dev/null || bp_fail "invalid published BlazeRental version code"
    case "$apk_url" in https://*) ;; *) bp_fail "provisioning APK URL must use HTTPS";; esac
    checksum="$(bp_admin_sha256_b64url "$apk_sha")" || bp_fail "unable to encode provisioning APK checksum"
    cert_pin="$(bp_admin_local_cert_pin "$server")" || bp_fail "unable to fingerprint local admin certificate"
    [ -n "$cert_pin" ] || bp_fail "Device Owner provisioning requires the local pinned admin certificate"
    bp_lock || bp_fail "enrollment registry busy"
    token="$(bp_rental_enroll_create "$label" 600)" || {
      bp_unlock
      bp_fail "enrollment token storage failed; QR not issued"
    }
    bp_unlock
    printf '%s' "$token" | LC_ALL=C grep -Eq '^[a-f0-9]{12}\.[a-f0-9]{36}$' ||
      bp_fail "invalid generated enrollment token; QR not issued"
    qr_payload="$(bp_admin_provisioning_payload "$server" "$token" "$label" "$apk_url" "$checksum" "$apk_code" "$cert_pin")"
    bp_auth_audit rental_provisioning_qr "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$(printf '%s' "$label:$apk_version" | cut -c1-96)"
    bp_json "$(printf '{"ok":true,"qr_type":"device_owner","enrollment_token":"%s","expires_seconds":600,"server_url":"%s","device_name":"%s","apk_version":"%s","apk_version_code":%s,"apk_url":"%s","apk_checksum":"%s","qr_payload":"%s"}' \
      "$(bp_json_escape "$token")" "$(bp_json_escape "$server")" "$(bp_json_escape "$label")" \
      "$(bp_json_escape "$apk_version")" "$apk_code" "$(bp_json_escape "$apk_url")" "$(bp_json_escape "$checksum")" "$(bp_json_escape "$qr_payload")")"
    ;;
  rental_list|rental_device_list)
    require_role viewer
    bp_rental_init
    body="$(bp_rental_list_json)"
    bp_json "$(printf '{"ok":true,"devices":%s}' "$body")"
    ;;
  rental_device_get)
    require_role viewer
    did="$(bp_param device_id)"
    [ -n "$(bp_rental_device_line "$did")" ] || bp_fail "unknown rental device"
    devices="$(bp_rental_list_json)"
    one="$(printf '%s' "$devices" | tr '{' '\n{' | grep -F "\"device_id\":\"$did\"" | head -n1)"
    [ -n "$one" ] || bp_fail "unknown rental device"
    one="{${one#*\{}"; one="${one%%\}*}}"
    policy="$(bp_rental_policy_v2_json "$did")" || bp_fail "policy unavailable"
    bp_json "$(printf '{"ok":true,"device":%s,"policy":%s}' "$one" "$policy")"
    ;;
  rental_policy_set)
    require_role admin
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    did="$(bp_param device_id)"
    [ -n "$(bp_rental_device_line "$did")" ] || bp_fail "unknown rental device"
    expected="$(bp_param expected_revision)"
    if [ -z "$expected" ]; then
      # Compatibility path for v0.3 admin clients.
      allowed="$(bp_param allowed_packages)"
      preferred="$(bp_param preferred_vendo)"
      bp_rental_policy_set "$did" "${allowed:-*}" "$preferred" || bp_fail "invalid rental policy"
      bp_rental_policy_migrate "$did" || bp_fail "policy migration failed"
      bp_auth_audit rental_policy_set "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$did:legacy"
      bp_json '{"ok":true,"compatibility_mode":true}'
      exit 0
    fi
    mode="$(bp_param launcher_mode)"; [ -n "$mode" ] || mode="@keep"
    allowed="$(bp_param allowed_packages)"; [ -n "$allowed" ] || allowed="@keep"
    hidden="$(bp_param hidden_packages)"; [ -n "$hidden" ] || hidden="@keep"
    preferred="$(bp_param preferred_vendo)"; [ -n "$preferred" ] || preferred="@keep"
    timer_mode="$(bp_param timer_mode)"; [ -n "$timer_mode" ] || timer_mode="@keep"
    timer="$(bp_param timer_user_toggle)"; [ -n "$timer" ] || timer="@keep"
    notifications="$(bp_param notifications_enabled)"; [ -n "$notifications" ] || notifications="@keep"
    quick="$(bp_param quick_controls)"; [ -n "$quick" ] || quick="@keep"
    gesture="$(bp_param admin_gesture_value)"; [ -n "$gesture" ] || gesture="@keep"
    admin_password="$(bp_param admin_password)"; [ -n "$admin_password" ] || admin_password="@keep"
    actor="admin:$BP_AUTH_USER"
    if newrev="$(bp_rental_policy_v2_patch "$did" "$expected" "$actor" "$mode" "$allowed" "$hidden" "$preferred" "$timer" "$notifications" "$quick" "$gesture" "$admin_password" "$timer_mode")"; then
      body="$(bp_rental_policy_v2_json "$did")" || bp_fail "policy unavailable"
      bp_auth_audit rental_policy_set "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$did:$newrev"
      bp_json "$(printf '{"ok":true,"policy_revision":%s,"policy":%s}' "$newrev" "$body")"
    else
      rc=$?
      [ "$rc" -eq 4 ] && {
        current="$(bp_rental_policy_v2_get "$did" | cut -f2)"
        bp_json "$(printf '{"ok":false,"error":"stale policy revision","current_revision":%s}' "${current:-0}")"
        exit 0
      }
      [ "$rc" -eq 2 ] && bp_fail "invalid rental policy"
      bp_fail "rental policy update failed"
    fi
    ;;
  rental_admin_password_set)
    require_role admin
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    did="$(bp_param device_id)"
    admin_password="$(bp_param admin_password)"
    [ -n "$(bp_rental_device_line "$did")" ] || bp_fail "unknown rental device"
    bp_rental_policy_migrate "$did" || bp_fail "policy migration failed"
    rev="$(bp_rental_policy_v2_get "$did" | cut -f2)"
    newrev="$(bp_rental_policy_v2_patch "$did" "$rev" "admin:$BP_AUTH_USER" @keep @keep @keep @keep @keep @keep @keep @keep "$admin_password")" || bp_fail "admin password must be at least 8 characters"
    bp_auth_audit rental_admin_password_set "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$did:$newrev"
    bp_json "$(printf '{"ok":true,"policy_revision":%s}' "$newrev")"
    ;;
  rental_update_get)
    require_role viewer
    command -v bp_rental_update_init >/dev/null 2>&1 || bp_fail "rental update subsystem unavailable"
    bp_rental_update_init
    body="$(bp_rental_update_json)"
    bp_json "$(printf '{"ok":true,"update":%s}' "$body")"
    ;;
  rental_update_set)
    require_role admin
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    command -v bp_rental_update_set >/dev/null 2>&1 || bp_fail "rental update subsystem unavailable"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    version="$(bp_param version)"; code="$(bp_param version_code)"
    url="$(bp_param apk_url)"; sha="$(bp_param apk_sha256)"
    rollback_version="$(bp_param rollback_version)"; rollback_code="$(bp_param rollback_version_code)"
    rollback_url="$(bp_param rollback_url)"; rollback_sha="$(bp_param rollback_sha256)"
    bp_rental_update_set "$version" "$code" "$url" "$sha" "$rollback_version" "$rollback_code" "$rollback_url" "$rollback_sha" || bp_fail "invalid rental update metadata"
    bp_auth_audit rental_update_set "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$version:$code"
    body="$(bp_rental_update_json)"
    bp_json "$(printf '{"ok":true,"update":%s}' "$body")"
    ;;
  member_export)
    require_role viewer
    command -v base64 >/dev/null 2>&1 || bp_fail "base64 utility unavailable"
    export_payload="$(bp_member_migration_export | base64 | tr -d '\r\n')"
    bp_json "$(printf '{"ok":true,"format":"BLAZE_MEMBER_METADATA_V1","filename":"BlazePwifi-members-%s.blazemembers","revision":%s,"payload_b64":"%s"}' \
      "$(date +%Y%m%d-%H%M%S)" "$(bp_member_global_revision)" "$(bp_json_escape "$export_payload")")"
    ;;
  member_import_preview)
    require_role admin
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    payload_b64="$(bp_param payload_b64)"
    token="$(bp_member_migration_preview_create "$payload_b64")"
    rc=$?
    case "$rc" in
      0) ;;
      3) bp_fail "admin session unavailable" ;;
      4) bp_fail "member metadata file is invalid or too large" ;;
      10) bp_fail "member metadata file format is invalid" ;;
      11) bp_fail "member metadata contains an invalid field" ;;
      12) bp_fail "member metadata contains duplicate usernames" ;;
      13) bp_fail "member metadata contains too many members" ;;
      *) bp_fail "unable to prepare member import preview" ;;
    esac
    items="$(bp_member_migration_preview_json "$token")" || bp_fail "unable to render import preview"
    count="$(bp_member_migration_preview_meta "$token" count)"
    creates="$(bp_member_migration_preview_meta "$token" creates)"
    collisions="$(bp_member_migration_preview_meta "$token" collisions)"
    requested_enabled="$(bp_member_migration_preview_meta "$token" requested_enabled)"
    export_revision="$(bp_member_migration_preview_meta "$token" export_revision)"
    expires="$(bp_member_migration_preview_meta "$token" expires)"
    bp_auth_audit member_import_preview "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "count=$count collisions=$collisions"
    bp_json "$(printf '{"ok":true,"preview_token":"%s","count":%s,"creates":%s,"collisions":%s,"requested_enabled":%s,"export_revision":%s,"expires":%s,"items":%s}' \
      "$(bp_json_escape "$token")" "${count:-0}" "${creates:-0}" "${collisions:-0}" "${requested_enabled:-0}" "${export_revision:-0}" "${expires:-0}" "$items")"
    ;;
  member_import_apply)
    require_role admin
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    token="$(bp_param preview_token)"; policy="$(bp_param collision_policy)"
    password="$(bp_param password)"
    bp_console_reauth "$password"
    rc=$?
    case "$rc" in
      0) ;;
      2) bp_fail "account temporarily locked" ;;
      *) bp_fail "re-authentication failed" ;;
    esac
    result="$(bp_member_migration_apply "$token" "$policy" "admin:$BP_AUTH_USER")"
    rc=$?
    case "$rc" in
      0) ;;
      1|2|3) bp_fail "import preview token expired or does not belong to this admin session" ;;
      6) bp_fail "member state changed after preview; preview the file again" ;;
      7) bp_fail "member import has username collisions; choose skip or metadata-only update" ;;
      8) bp_fail "invalid collision policy" ;;
      9|15) bp_fail "member state is busy or rollback failed" ;;
      14) bp_fail "member import failed; all member state was rolled back" ;;
      16) bp_fail "unsigned metadata cannot restore paid member time; use a verified financial migration" ;;
      *) bp_fail "member import could not be applied" ;;
    esac
    created="$(printf '%s' "$result" | cut -f1)"
    updated_count="$(printf '%s' "$result" | cut -f2)"
    skipped="$(printf '%s' "$result" | cut -f3)"
    revision="$(printf '%s' "$result" | cut -f4)"
    bp_auth_audit member_import_apply "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "policy=$policy created=$created updated=$updated_count skipped=$skipped revision=$revision"
    bp_json "$(printf '{"ok":true,"created":%s,"updated":%s,"skipped":%s,"revision":%s,"new_members_require_password_reset":true}' \
      "${created:-0}" "${updated_count:-0}" "${skipped:-0}" "${revision:-0}")"
    ;;
  member_list)
    require_role viewer
    body="$(bp_member_public_list_json)"
    revision="$(bp_member_global_revision)"
    bp_json "$(printf '{"ok":true,"revision":%s,"members":%s}' "$revision" "$body")"
    ;;
  member_events)
    require_role viewer
    user="$(bp_param username)"
    if [ -n "$user" ]; then user="$(bp_member_norm "$user")" || bp_fail "invalid member"; fi
    limit="$(bp_param limit)"; [ -n "$limit" ] || limit=64
    body="$(bp_member_events_json "$limit" "$user")"
    bp_json "$(printf '{"ok":true,"events":%s}' "$body")"
    ;;
  member_create)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    user="$(bp_param username)"; label="$(bp_param label)"; password="$(bp_param password)"
    bp_member_lock || bp_fail "member state busy"
    revision="$(bp_member_create "$user" "$label" "$password" "admin:$BP_AUTH_USER")"
    rc=$?
    bp_member_unlock
    case "$rc" in
      0) ;;
      2) bp_fail "invalid member username or password; username must be 2-32 safe characters and password at least 8 characters" ;;
      3) bp_fail "member already exists" ;;
      *) bp_fail "member creation failed" ;;
    esac
    bp_auth_audit member_create "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$user:$revision"
    bp_json "$(printf '{"ok":true,"username":"%s","revision":%s}' "$(bp_json_escape "$user")" "$revision")"
    ;;
  member_update)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    user="$(bp_param username)"; label="$(bp_param label)"; enabled="$(bp_param enabled)"
    [ -n "$label" ] || label="@keep"
    [ -n "$enabled" ] || enabled="@keep"
    bp_member_lock || bp_fail "member state busy"
    revision="$(bp_member_patch "$user" "$label" "$enabled" "admin:$BP_AUTH_USER")"
    rc=$?
    bp_member_unlock
    case "$rc" in
      0) ;;
      2) bp_fail "invalid member update" ;;
      3) bp_fail "unknown member" ;;
      *) bp_fail "member update failed" ;;
    esac
    bp_auth_audit member_update "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$user:$revision"
    bp_json "$(printf '{"ok":true,"username":"%s","revision":%s}' "$(bp_json_escape "$user")" "$revision")"
    ;;
  member_balance)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    user="$(bp_param username)"; mode="$(bp_param mode)"; seconds="$(bp_param seconds)"
    case "$mode" in add|subtract|set) ;; *) bp_fail "invalid balance mode";; esac
    bp_member_lock || bp_fail "member state busy"
    result="$(bp_member_balance_change "$user" "$mode" "$seconds" "admin:$BP_AUTH_USER" "")"
    rc=$?
    bp_member_unlock
    case "$rc" in
      0) ;;
      2) bp_fail "invalid balance value" ;;
      3) bp_fail "unknown member" ;;
      4) bp_fail "insufficient banked time" ;;
      *) bp_fail "member balance update failed" ;;
    esac
    applied="$(printf '%s' "$result" | cut -f1)"; revision="$(printf '%s' "$result" | cut -f2)"
    bp_auth_audit member_balance "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$user:$mode:$seconds:$revision"
    bp_json "$(printf '{"ok":true,"username":"%s","applied_seconds":%s,"revision":%s}' "$(bp_json_escape "$user")" "${applied:-0}" "${revision:-0}")"
    ;;
  member_transfer)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    from="$(bp_param from_username)"; to="$(bp_param to_username)"; seconds="$(bp_param seconds)"
    bp_member_lock || bp_fail "member state busy"
    result="$(bp_member_transfer "$from" "$to" "$seconds" "admin:$BP_AUTH_USER" "")"
    rc=$?
    bp_member_unlock
    case "$rc" in
      0) ;;
      2) bp_fail "invalid transfer" ;;
      3) bp_fail "unknown member" ;;
      4) bp_fail "insufficient banked time" ;;
      *) bp_fail "member transfer failed" ;;
    esac
    applied="$(printf '%s' "$result" | cut -f1)"; revision="$(printf '%s' "$result" | cut -f2)"
