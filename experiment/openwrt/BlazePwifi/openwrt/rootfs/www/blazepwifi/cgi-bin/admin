    bp_json "$(printf '{"ok":true,"remote":%s}' "$remote")"
    ;;
  remote_zerotier_disable)
    require_role admin
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    password="$(bp_param password)"
    bp_console_reauth "$password"
    rc=$?
    case "$rc" in
      0) ;;
      2) bp_fail "account temporarily locked" ;;
      *) bp_fail "re-authentication failed" ;;
    esac
    bp_remote_zerotier_disable "${REMOTE_ADDR:-}"
    rc=$?
    case "$rc" in
      0) ;;
      20) bp_fail "another remote-access transaction is already pending" ;;
      22) bp_fail "default route unavailable; refusing ZeroTier disable" ;;
      23) bp_fail "unable to create remote-access rollback snapshot" ;;
      29|30|44|45|48|49) bp_fail "ZeroTier disable could not be completed safely; previous network restored" ;;
      31) bp_fail "disable ZeroTier from a local/non-ZeroTier management path" ;;
      42) bp_fail "ZeroTier is not currently active" ;;
      *) bp_fail "ZeroTier disable failed safely" ;;
    esac
    bp_auth_audit remote_zerotier_disable "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "staged"
    remote="$(bp_remote_status_json)"
    bp_json "$(printf '{"ok":true,"remote":%s}' "$remote")"
    ;;
  terminal_status)
    require_role admin
    require_remote_terminal_permission
    if bp_terminal_enabled; then enabled=true; else enabled=false; fi
    active="$(bp_terminal_active_count)"
    ttl="$(bp_terminal_cfg_uint terminal_ttl_seconds 300 60 1800)"
    idle="$(bp_terminal_cfg_uint terminal_idle_seconds 60 15 900)"
    timeout_seconds="$(bp_terminal_cfg_uint terminal_command_timeout_seconds 12 2 60)"
    output_max="$(bp_terminal_cfg_uint terminal_output_max_bytes 16000 1024 65536)"
    bp_json "$(printf '{"ok":true,"enabled":%s,"active_sessions":%s,"ttl_seconds":%s,"idle_seconds":%s,"command_timeout_seconds":%s,"output_max_bytes":%s}' "$enabled" "$active" "$ttl" "$idle" "$timeout_seconds" "$output_max")"
    ;;
  terminal_set_enabled)
    require_role admin
    require_remote_terminal_permission
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    enabled="$(bp_param enabled)"
    case "$enabled" in 0|1) ;; *) bp_fail "invalid terminal state";; esac
    password="$(bp_param password)"
    bp_console_reauth "$password"
    rc=$?
    case "$rc" in
      0) ;;
      2) bp_fail "account temporarily locked" ;;
      *) bp_fail "re-authentication failed" ;;
    esac
    bp_config_set advanced_terminal_enabled "$enabled" || bp_fail "unable to update terminal state"
    [ "$enabled" = 1 ] || bp_terminal_close_all
    bp_auth_audit terminal_enabled "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$enabled"
    bp_json "$(printf '{"ok":true,"enabled":%s}' "$([ "$enabled" = 1 ] && printf true || printf false)")"
    ;;
  terminal_open)
    require_role admin
    require_remote_terminal_permission
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    password="$(bp_param password)"
    token="$(bp_terminal_open "$password")"
    rc=$?
    case "$rc" in
      0) ;;
      10) bp_fail "Advanced Terminal is disabled" ;;
      11) bp_fail "admin role required" ;;
      12) bp_fail "password change required" ;;
      2) bp_fail "account temporarily locked" ;;
      *) bp_fail "terminal re-authentication failed" ;;
    esac
    ttl="$(bp_terminal_cfg_uint terminal_ttl_seconds 300 60 1800)"
    idle="$(bp_terminal_cfg_uint terminal_idle_seconds 60 15 900)"
    bp_json "$(printf '{"ok":true,"terminal_token":"%s","ttl_seconds":%s,"idle_seconds":%s}' "$(bp_json_escape "$token")" "$ttl" "$idle")"
    ;;
  terminal_exec)
    require_role admin
    require_remote_terminal_permission
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    token="$(bp_param terminal_token)"; command_text="$(bp_param command)"
    bp_terminal_exec "$token" "$command_text"
    rc=$?
    case "$rc" in
      0) ;;
      2) bp_fail "command blocked; use a dedicated guarded control for this operation" ;;
      4) bp_fail "terminal session expired or invalid" ;;
      5) bp_fail "another terminal command is already running" ;;
      127) bp_fail "bounded timeout utility unavailable on this target" ;;
      *) bp_fail "invalid terminal command" ;;
    esac
    bp_json "$(printf '{"ok":true,"exit_code":%s,"output":"%s"}' "${BP_TERMINAL_RC:-1}" "$(bp_json_escape "${BP_TERMINAL_OUTPUT:-}")")"
    ;;
  terminal_close)
    require_role admin
    require_remote_terminal_permission
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    token="$(bp_param terminal_token)"
    bp_terminal_close "$token" || bp_fail "unable to close terminal session"
    bp_json '{"ok":true}'
    ;;
  tool_run)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    tool="$(bp_param tool)"; target="$(bp_param target)"
    case "$target" in
      *[!A-Za-z0-9._:-]* ) bp_fail "invalid diagnostic target" ;;
    esac
    [ "$(printf '%s' "$target" | wc -c)" -le 253 ] || bp_fail "diagnostic target too long"
    output=""; rc=0
    case "$tool" in
      ping)
        [ -n "$target" ] || target="1.1.1.1"
        output="$(ping -c 4 -W 2 "$target" 2>&1 | head -c 12000)" || rc=$?
        ;;
      traceroute)
        [ -n "$target" ] || target="1.1.1.1"
        if command -v traceroute >/dev/null 2>&1; then output="$(traceroute -m 12 "$target" 2>&1 | head -c 12000)" || rc=$?; else output="traceroute is not installed on this target"; rc=127; fi
        ;;
      dns)
        [ -n "$target" ] || target="openai.com"
        if command -v nslookup >/dev/null 2>&1; then output="$(nslookup "$target" 2>&1 | head -c 12000)" || rc=$?; else output="nslookup is not installed on this target"; rc=127; fi
        ;;
      routes) output="$(ip route 2>&1 | head -c 12000)" || rc=$? ;;
      interfaces) output="$(ip addr 2>&1 | head -c 12000)" || rc=$? ;;
      wifi)
        if command -v iw >/dev/null 2>&1; then output="$(iw dev 2>&1 | head -c 12000)" || rc=$?; else output="iw is not installed / no Wi-Fi capability"; rc=127; fi
        ;;
      storage) output="$(df -h 2>&1 | head -c 12000)" || rc=$? ;;
      uptime) output="$(uptime 2>&1 | head -c 12000)" || rc=$? ;;
      wan)
        output="$({ ip route show default 2>/dev/null; if command -v ubus >/dev/null 2>&1; then ubus call network.interface.wan status 2>/dev/null || true; fi; } | head -c 12000)" || rc=$?
        ;;
      ntp)
        output="$({ date -u 2>/dev/null; if command -v ubus >/dev/null 2>&1; then ubus call system info 2>/dev/null || true; fi; if command -v logread >/dev/null 2>&1; then logread 2>/dev/null | grep -iE 'ntp|timesync|clock' | tail -n 30; fi; } | head -c 12000)" || rc=$?
        ;;
      jitter)
        [ -n "$target" ] || target="1.1.1.1"
        output="$(ping -c 10 -W 2 "$target" 2>&1 | head -c 12000)" || rc=$?
        ;;
      port)
        [ -n "$target" ] || bp_fail "port check target must be host:port"
        host="${target%:*}"; port="${target##*:}"
        [ "$host" != "$target" ] && [ -n "$host" ] || bp_fail "port check target must be host:port"
        case "$port" in ''|*[!0-9]*) bp_fail "invalid port";; esac
        [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || bp_fail "invalid port"
        if command -v nc >/dev/null 2>&1; then
          port_tmp="$BP_RUN/.port-check.$(bp_tmp_suffix)"
          nc -z -w 3 "$host" "$port" >"$port_tmp" 2>&1
          rc=$?
          output="$(cat "$port_tmp" 2>/dev/null; printf 'Port check completed for %s:%s\n' "$host" "$port")"
          rm -f "$port_tmp"
        else output="nc is not installed on this target"; rc=127; fi
        output="$(printf '%s' "$output" | head -c 12000)"
        ;;
      neighbors) output="$(ip neigh show 2>&1 | head -c 12000)" || rc=$? ;;
      logs)
        if command -v logread >/dev/null 2>&1; then output="$(logread 2>&1 | tail -n 120 | head -c 12000)" || rc=$?; else output="logread is unavailable"; rc=127; fi
        ;;
      services)
        if command -v ubus >/dev/null 2>&1; then output="$(ubus call service list 2>&1 | head -c 12000)" || rc=$?; else output="$(ps 2>&1 | head -c 12000)" || rc=$?; fi
        ;;
      controllers)
        output="$(awk -F '\t' -v n="$now" 'NF>=2 {age=n-$2; printf "%s  age=%ss  ip=%s\n",$1,age,$3}' "$BP_VENDOS" 2>/dev/null | head -c 12000)" || rc=$?
        ;;
      speedtest)
        if command -v speedtest >/dev/null 2>&1; then output="$(timeout 45 speedtest 2>&1 | head -c 12000)" || rc=$?;
        elif command -v librespeed-cli >/dev/null 2>&1; then output="$(timeout 45 librespeed-cli 2>&1 | head -c 12000)" || rc=$?;
        else output="No local speed-test helper is installed. Use Ping/latency now or install a supported speed-test package on this target."; rc=127; fi
        ;;
      *) bp_fail "unsupported safe command" ;;
    esac
    bp_auth_audit tool_run "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$tool"
    bp_json "$(printf '{"ok":true,"tool":"%s","exit_code":%s,"output":"%s"}' "$(bp_json_escape "$tool")" "${rc:-0}" "$(bp_json_escape "$output")")"
    ;;
  status)
    require_role viewer
    sessions="$(awk -F '\t' -v n="$now" '$5!=1 && $3>n {c++} END{print c+0}' "$BP_ACCOUNTS")"
    paused="$(awk -F '\t' '$5==1 && $4>0 {c++} END{print c+0}' "$BP_ACCOUNTS")"
    vendos="$(awk -F '\t' -v n="$now" '$2>(n-30) {c++} END{print c+0}' "$BP_VENDOS")"
    free_kb="$(awk '/MemAvailable:/ {print $2; found=1} END{if(!found) print 0}' /proc/meminfo)"
    load="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"; uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
    body="$(printf '{"ok":true,"username":"%s","role":"%s","must_change":%s,"active_sessions":%s,"paused_sessions":%s,"online_vendos":%s,"mem_available_kb":%s,"load1":"%s","uptime_seconds":%s}' "$(bp_json_escape "$BP_AUTH_USER")" "$(bp_json_escape "$BP_AUTH_ROLE")" "${BP_AUTH_MUST_CHANGE:-0}" "$sessions" "$paused" "$vendos" "${free_kb:-0}" "${load:-0}" "${uptime:-0}")"
    bp_json "$body"
    ;;
  voucher_create)
    require_role operator
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    [ "${BP_AUTH_MUST_CHANGE:-0}" != 1 ] || bp_fail "password change required"
    cents="$(bp_param cents)"; case "$cents" in ''|*[!0-9]*) bp_fail "invalid amount";; esac
    [ "$cents" -gt 0 ] 2>/dev/null || bp_fail "invalid amount"
    bp_lock || bp_fail "accounting busy"
    i=0
    while :; do
      code="$(hexdump -n 5 -e '5/1 "%02X"' /dev/urandom 2>/dev/null || od -An -N5 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' | tr 'a-f' 'A-F')"
      [ -n "$code" ] || code="$(date +%s)"
      grep -q "^$code\t" "$BP_VOUCHERS" 2>/dev/null || break
      i=$((i+1)); [ "$i" -lt 10 ] || { bp_unlock; bp_fail "voucher generator unavailable"; }
    done
    tmp="$BP_STATE/.vouchers.$(bp_tmp_suffix)"
    cat "$BP_VOUCHERS" > "$tmp"
    printf '%s\t%s\n' "$code" "$cents" >> "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$BP_VOUCHERS"
    bp_durable_sync
    bp_auth_audit voucher_create "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "$cents"
    bp_unlock
    body="$(printf '{"ok":true,"code":"%s","cents":%s}' "$(bp_json_escape "$code")" "$cents")"
    bp_json "$body"
    ;;
  password_change)
    require_role viewer
    bp_auth_csrf_ok || bp_fail "csrf validation failed"
    new_password="$(bp_param new_password)"
    [ -n "$new_password" ] || bp_fail "missing new password"
    [ "${#new_password}" -ge 12 ] || bp_fail "password must be at least 12 characters"
    bp_auth_lock || bp_fail "authentication busy"
    # The credential and old-session store are not one durable transaction.
    # Revoke first under the auth lock: if storage fails, the old password
    # remains unchanged and no pre-change session is silently trusted.
    if ! bp_auth_invalidate_user_sessions "$BP_AUTH_USER"; then
      bp_auth_audit session_revoke_failure "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "password_not_changed" || true
      bp_auth_unlock
      bp_fail "could not revoke existing sessions; password was not changed"
    fi
    if bp_auth_set_password "$BP_AUTH_USER" "$BP_AUTH_ROLE" "$new_password" 0; then
      if ! rm -f /etc/blazepwifi/INITIAL_ADMIN_PASSWORD 2>/dev/null ||
         ! bp_auth_audit password_changed "$BP_AUTH_USER" "${REMOTE_ADDR:-unknown}" "self"; then
        bp_auth_unlock
        bp_fail "password changed but admin cleanup/audit failed; operator reconciliation required"
      fi
      bp_auth_unlock
      bp_json '{"ok":true,"reauth_required":true}'
    else
      rc=$?; bp_auth_unlock
      [ "$rc" -eq 2 ] && bp_fail "password must be at least 12 characters"
      bp_fail "password change failed"
    fi
    ;;
  *) bp_fail "unknown admin action" ;;
esac
